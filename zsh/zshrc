# Switch container engine for this shell (and children).
# Usage: use-rancher | use-podman | docker-engine
use-rancher() {
  unset DOCKER_HOST
  export PATH="$HOME/.rd/bin:$PATH"
  if command -v docker >/dev/null 2>&1; then
    docker context use rancher-desktop >/dev/null
  fi
  echo "docker -> rancher-desktop ($(docker context show 2>/dev/null || echo unknown))"
}

use-podman() {
  # Prefer an explicit podman docker context if present; else set DOCKER_HOST to the machine socket.
  if docker context ls --format '{{.Name}}' 2>/dev/null | grep -qx 'podman'; then
    unset DOCKER_HOST
    docker context use podman >/dev/null
  else
    local sock=""
    sock="$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true)"
    if [[ -z "$sock" || ! -S "$sock" ]]; then
      # fallbacks used by the existing Podman block above
      for candidate in         "${XDG_RUNTIME_DIR:-/tmp}/podman/podman.sock"         "${TMPDIR:-/tmp}podman/podman-machine-default-api.sock"         "$HOME/.local/share/containers/podman/machine/podman.sock"
      do
        [[ -S "$candidate" ]] && sock="$candidate" && break
      done
    fi
    if [[ -n "$sock" && -S "$sock" ]]; then
      export DOCKER_HOST="unix://$sock"
    else
      echo "use-podman: no running Podman socket found (start with: podman machine start)" >&2
      return 1
    fi
  fi
  echo "docker -> podman (${DOCKER_HOST:-context=$(docker context show 2>/dev/null)})"
}

docker-engine() {
  echo "context: $(docker context show 2>/dev/null || echo n/a)"
  echo "DOCKER_HOST: ${DOCKER_HOST:-<unset>}"
  docker version --format 'server: {{.Server.Version}} ({{.Server.Os}}/{{.Server.Arch}})' 2>/dev/null || echo 'server: unreachable'
}
