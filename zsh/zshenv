# Machine-local secrets/env (not tracked)
# Keep this lightweight (plain exports only) to avoid slowing shell startup.
if [[ -o interactive ]]; then
  [[ -r "$HOME/.config/secrets/env.zsh" ]] && source "$HOME/.config/secrets/env.zsh"
fi

# Prefer Rancher Desktop when present; otherwise leave unset (or set Podman explicitly).
if [[ -S "$HOME/.rd/docker.sock" ]]; then
  unset DOCKER_HOST
elif [[ -S "${TMPDIR:-/tmp}podman/podman-machine-default-api.sock" ]]; then
  export DOCKER_HOST="unix://${TMPDIR:-/tmp}podman/podman-machine-default-api.sock"
fi

[[ -r "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# The ChatGPT-bundled Codex CLI uses rustls in terminal sessions. Give it an
# explicit readable trust bundle so Herdr shells do not inherit a stale or
# unavailable corporate CA path from the long-running server process.
if [[ -z "${CODEX_CA_CERTIFICATE-}" || ! -r "$CODEX_CA_CERTIFICATE" ]]; then
  [[ -r /etc/ssl/cert.pem ]] && export CODEX_CA_CERTIFICATE=/etc/ssl/cert.pem
fi

# Plannotator reads regular OpenCode's v1 transcript database. OpenCode2 uses
# an incompatible schema in the default data directory.
export OPENCODE_DB="$HOME/.local/share/opencode-v1/opencode/opencode.db"

# Never upload plans to share.plannotator.ai (or auto-create public short links).
export PLANNOTATOR_SHARE=disabled
# Keep URL annotation on-box; do not send pages through Jina Reader.
export PLANNOTATOR_JINA=0

# CWS / SSH: fixed local UI port so the laptop can tunnel it. This is not a
# public share — PLANNOTATOR_SHARE=disabled hides share/import and stops the
# remote-HTML auto short-link upload.
if [[ -d /.cws || -n ${CWS_WORKSPACE_ID-} || -n ${CWS_USER_DOTFILES_REPO_URL-} ]] \
  || { [[ -d /workspace ]] && [[ "$(id -un 2>/dev/null || true)" == "coder" ]]; }; then
  export PLANNOTATOR_REMOTE=1
  export PLANNOTATOR_PORT="${PLANNOTATOR_PORT:-19432}"
fi
