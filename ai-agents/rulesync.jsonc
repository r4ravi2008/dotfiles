{
  "$schema": "https://raw.githubusercontent.com/dyoshikawa/rulesync/refs/heads/main/config-schema.json",
  // Skills are not generated per tool. Bootstrap installs them into
  // ~/.agents/skills and symlinks ~/.claude/skills and ~/.cursor/skills there.
  "targets": {
    "opencode": ["rules", "ignore", "mcp", "commands", "subagents"],
    "codexcli": ["rules", "ignore", "mcp", "commands", "subagents"],
    "cursor": ["rules", "ignore", "mcp", "commands", "subagents"],
    "claudecode": ["rules", "ignore", "mcp", "commands", "subagents"],
  },
  "baseDirs": ["."],
  "delete": true,
  "verbose": false,
  "silent": false,
  "global": false,
  "simulateCommands": true,
  "simulateSubagents": true,
  "simulateSkills": false,
  "modularMcp": false,
}
