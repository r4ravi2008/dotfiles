{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@ex-machina/opencode-anthropic-auth"],
  "model": "openai/gpt-5.4",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "--bun", "@upstash/context7-mcp"],
      "enabled": false,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "--bun", "@playwright/mcp@latest"],
      "enabled": false,
      "environment": {}
    },
    "pdf-reader": {
      "type": "local",
      "command": ["bunx", "--bun", "@sylphx/pdf-reader-mcp"],
      "enabled": false,
      "environment": {}
    },
    "MiniMax": {
      "type": "local",
      "command": ["uvx", "minimax-coding-plan-mcp", "-y"],
      "enabled": false,
      "environment": {
        "MINIMAX_API_HOST": "https://api.minimax.io"
      }
    },
    "x-twitter-mcp": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/Users/aira/projects/mcps/x-twitter-mcp-server",
        "run",
        "x-twitter-mcp-server"
      ],
      "enabled": false,
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "twitter-bookmarks": {
      "type": "remote",
      "url": "https://bookmarksmcp.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest",
        "--autoconnect",
        "--channel=beta"
      ]
    }
  },
  "agent": {
    "build": {
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "external_directory": {
          "/tmp*": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow"
      }
    }
  }
}
