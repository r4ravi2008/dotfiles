#!/usr/bin/env bash
# Cloud Workspaces entrypoint.
# CWS copies this repo onto $HOME and runs this file if it is executable.
# See cws-runner/prebuild/set-up-user.sh and cws-docs developing/workspace-customization-dotfiles.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_PROFILE="${DOTFILES_PROFILE:-cws}"

# CWS copies this repo onto $HOME without .git, so `git pull` would fail if we
# only relocated those files. Clone the live repo into ~/.dotfiles instead.
CWS_DOTFILES_REMOTE="${CWS_DOTFILES_REMOTE:-https://github.intuit.com/rkommineni/cws-dotfiles.git}"
CWS_DOTFILES_REF="${CWS_DOTFILES_REF:-main}"

if [[ ! -d "$HOME/.dotfiles/.git" ]]; then
	if [[ -d "$HOME/.dotfiles" && ! -d "$HOME/.dotfiles/nvim" ]]; then
		rmdir "$HOME/.dotfiles" 2>/dev/null || true
	fi
	if [[ -d "$HOME/.dotfiles" && ! -d "$HOME/.dotfiles/.git" ]]; then
		mv "$HOME/.dotfiles" "$HOME/.dotfiles.bak.$$"
	fi
	git clone --branch "$CWS_DOTFILES_REF" "$CWS_DOTFILES_REMOTE" "$HOME/.dotfiles"
fi

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
if [[ ! -x "$DOTFILES_DIR/bootstrap.sh" ]]; then
	DOTFILES_DIR="$ROOT"
fi

exec "$DOTFILES_DIR/bootstrap.sh" --profile cws
