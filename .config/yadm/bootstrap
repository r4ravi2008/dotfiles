#!/usr/bin/env bash
# Cloud Workspaces entrypoint.
# CWS copies this repo onto $HOME and runs this file if it is executable.
# See cws-runner/prebuild/set-up-user.sh and cws-docs developing/workspace-customization-dotfiles.md
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DOTFILES_PROFILE="${DOTFILES_PROFILE:-cws}"

# Keep the same ~/.dotfiles layout used on the laptop. CWS copies the repo
# into $HOME (nvim/, zsh/, bootstrap.sh, …), which we relocate once.
if [[ ! -d "$HOME/.dotfiles/nvim" && -d "$ROOT/nvim" && "$ROOT" == "$HOME" ]]; then
	mkdir -p "$HOME/.dotfiles"
	# Leave .bash_aliases in $HOME so CWS default .bashrc can source it even
	# if bootstrap later fails. bootstrap.sh will symlink it into ~/.dotfiles.
	for item in nvim zsh tmux herdr opencode ai-agents ghostty skhd lazygit cursor \
		bootstrap.sh packages.conf README.md AGENTS.md; do
		if [[ -e "$HOME/$item" && ! -e "$HOME/.dotfiles/$item" ]]; then
			mv "$HOME/$item" "$HOME/.dotfiles/"
		fi
	done
fi

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
if [[ ! -x "$DOTFILES_DIR/bootstrap.sh" ]]; then
	DOTFILES_DIR="$ROOT"
fi

exec "$DOTFILES_DIR/bootstrap.sh" --profile cws
